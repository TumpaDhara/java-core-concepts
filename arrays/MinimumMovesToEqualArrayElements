import java.util.Arrays;

class Solution {
    public int minMoves(int[] nums) {
        if (nums == null || nums.length == 0) return 0;
        
        // 1. Find the maximum element in the array
        int max = nums[0];
        for (int num : nums) {
            if (num > max) {
                max = num;
            }
        }
        
        // 2. Calculate moves needed to make every element equal to 'max'
        int moves = 0;
        for (int num : nums) {
            moves += (max - num);
        }
        
        return moves;
    }
}
